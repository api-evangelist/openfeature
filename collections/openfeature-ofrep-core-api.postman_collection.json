    {
      "id": "684f801e-091e-4952-b9b8-c7194396ad8d",
      "name": "OFREP Core",
      "description": {
        "content": "**Required**: Core APIs to implement to support OFREP.  \n*This is the minimum set of APIs required for a flag management system to be OFREP compatible.*\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2a17cc2c-d166-48bf-8bc0-1165e420ce88",
          "name": "Evaluate A Single Feature Flag",
          "request": {
            "name": "Evaluate A Single Feature Flag",
            "description": {
              "content": "Evaluates a single feature flag by its key. This endpoint is used by **server-side providers** \nfor dynamic context evaluation, where each evaluation request includes the evaluation context.\n\nThe endpoint returns the evaluated flag value along with metadata including the evaluation \nreason, variant, and any flag-specific metadata. The flag value can be one of several types: \nboolean, string, integer, float, object, or a code default (indicating the provider should \nuse the code default value).\n\n**Use Case**: Server-side applications where evaluation context may change between requests \nand real-time targeting decisions are required.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ofrep",
                "v1",
                "evaluate",
                "flags",
                ":key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) The unique identifier (key) of the feature flag"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"targetingKey\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
